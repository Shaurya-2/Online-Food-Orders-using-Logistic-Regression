X_test_prediction = model.predict(X_test)
testing_data_accuracy = metrics.accuracy_score(X_test_prediction,Y_test)

Y_test_numeric = np.where(Y_test == "Yes", 1, 0)
X_test_pred_numeric = np.where(X_test_prediction == "Yes", 1, 0)

score1 = metrics.mean_absolute_error(Y_test_numeric, X_test_pred_numeric)

score2 = metrics.r2_score(Y_test_numeric, X_test_pred_numeric)

