import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn import metrics
from sklearn.preprocessing import LabelEncoder
import matplotlib.pyplot as plt
import seaborn as sns

dataset = pd.read_csv('online.csv')
dataset.rename(columns={'Unnamed: 12':'Variables'},inplace=True)
print(dataset)

X = dataset.drop(columns = 'Output',axis = 1)
Categorical_Columns = ['Gender','Marital Status','Occupation','Monthly Income','Educational Qualifications','Feedback','Variables']
Z = LabelEncoder()
for col in Categorical_Columns:
  X[col] = Z.fit_transform(X[col])



Y = dataset['Output']

scaler = StandardScaler()
scaler.fit(X)
standardized_data = scaler.transform(X)

X = standardized_data

X_train, X_test, Y_train, Y_test = train_test_split(X,Y,test_size=0.3,random_state=2)
print(X.shape,X_train.shape,X_test.shape)

model = LogisticRegression()

model.fit(X_train,Y_train)
LogisticRegression()

X_train_prediction = model.predict(X_train)
training_data_accuracy = metrics.accuracy_score(X_train_prediction,Y_train)

Y_train_numeric = np.where(Y_train == "Yes", 1, 0)
X_train_pred_numeric = np.where(X_train_prediction == "Yes", 1, 0)

score1 = metrics.mean_absolute_error(Y_train_numeric, X_train_pred_numeric)

score2 = metrics.r2_score(Y_train_numeric, X_train_pred_numeric)

